# Database
DB_URL=jdbc:postgresql://localhost:5432/aijobagent
DB_USERNAME=aijobagent
DB_PASSWORD=aijobagent

# AI: set false only after adding an API key
APP_MOCK_AI=true
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Daily schedule
APP_DAILY_ENABLED=true
APP_DAILY_CRON=0 0 11 * * *
APP_TIME_ZONE=Asia/Kolkata
APP_STRONG_MATCH_THRESHOLD=85

# Comma-separated filters
APP_TARGET_LOCATIONS=Dubai,UAE,Netherlands,UK
APP_TARGET_TITLES=Java Backend Engineer,Senior Java Engineer,Lead Java Engineer,Staff Backend Engineer

# Add Greenhouse and SmartRecruiters providers in application-local.yml.
